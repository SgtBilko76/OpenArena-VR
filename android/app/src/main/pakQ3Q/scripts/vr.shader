
//
// VR Hud Shader Sprite - the image is just a placeholder and is replaced in code
//

sprites/vr/hud
{
	cull disable
	{
		clampmap sprites/plasmaa.tga
		blendfunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
	}
}
// OpenArena VR: 3D crosshairs (OpenArena crosshairs a-j), coloured per entity
sprites/vr/crosshaira
{
	nopicmip
	cull disable
	{
		map gfx/2d/crosshaira.tga
		blendfunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen entity
		alphaGen entity
	}
}
